<UserControl x:Class="Deltha.Views.MascotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="62">
    <Border Width="62"
            Height="62"
            CornerRadius="31"
            Background="#17212C"
            BorderBrush="#A78BFA"
            BorderThickness="1.4"
            ToolTip="{Binding StateLabel}">
        <TextBlock Text="{Binding MascotEmoji}"
                   FontSize="26"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>
</UserControl>
