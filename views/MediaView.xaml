<UserControl x:Class="Deltha.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel Margin="0,10,0,0">
        <Border Height="1"
                Background="#30343A"
                Margin="4,0,4,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="38"
                    Height="38"
                    CornerRadius="19"
                    Background="#1F2937"
                    BorderBrush="#7C3AED"
                    BorderThickness="1"
                    Margin="0,0,10,0">
                <TextBlock Text="♫"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        MinWidth="0">
                <TextBlock Text="{Binding TrackTitle}"
                           Foreground="#F8FAFC"
                           FontWeight="SemiBold"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="180"/>
                <TextBlock Text="{Binding ArtistName}"
                           Foreground="#A1B0C7"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="180"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button Command="{Binding PreviousTrackCommand}"
                        Content="⏮"
                        Width="30"
                        Height="30"
                        Margin="0,0,4,0"
                        Background="#1F2937"
                        Foreground="#F8FAFC"
                        ToolTip="Previous track"/>
                <Button Command="{Binding TogglePlayPauseCommand}"
                        Width="34"
                        Height="34"
                        Margin="0,0,4,0"
                        Background="#7C3AED"
                        Foreground="#FFFFFF"
                        ToolTip="Play or pause">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="▶"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Content" Value="⏸"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding NextTrackCommand}"
                        Content="⏭"
                        Width="30"
                        Height="30"
                        Margin="0,0,4,0"
                        Background="#1F2937"
                        Foreground="#F8FAFC"
                        ToolTip="Next track"/>
                <Button Command="{Binding ToggleLyricsCommand}"
                        Content="📜"
                        Width="32"
                        Height="32"
                        Background="#1F2937"
                        Foreground="#F8FAFC"
                        ToolTip="Show or hide lyrics"/>
            </StackPanel>
        </Grid>

        <Border Margin="0,10,0,0"
                Padding="8"
                Background="#101827"
                CornerRadius="12"
                Visibility="{Binding IsLyricsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer MaxHeight="140"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding LyricsText}"
                           Foreground="#E2E8F0"
                           TextWrapping="Wrap"
                           FontSize="11"
                           LineHeight="18"/>
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
