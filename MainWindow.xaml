<Window x:Class="Deltha.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Deltha.ViewModels"
        xmlns:views="clr-namespace:Deltha.Views"
        Title="Deltha Dynamic Island"
        Width="380"
        Height="Auto"
        MinHeight="60"
        SizeToContent="Height"
        SizeChanged="Window_SizeChanged"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="0"
        Top="0"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="DarkPanelBrush" Color="#111827"/>
        <SolidColorBrush x:Key="DarkPanelSecondaryBrush" Color="#17212C"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#A78BFA"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Border x:Name="IslandBorder"
                Background="#181818"
                CornerRadius="25"
                Padding="12"
                AllowDrop="True"
                DragEnter="IslandBorder_DragEnter"
                DragOver="IslandBorder_DragOver"
                DragLeave="IslandBorder_DragLeave"
                Drop="IslandBorder_Drop"
                MouseEnter="IslandBorder_MouseEnter"
                MouseLeave="IslandBorder_MouseLeave"
                MouseLeftButtonDown="Island_MouseLeftButtonDown"
                MouseRightButtonDown="Island_MouseRightButtonDown">
            <StackPanel Orientation="Vertical">
                <Border x:Name="SystemNotificationBorder"
                        Padding="8,6"
                        Margin="0,0,0,8"
                        CornerRadius="10"
                        Background="#2B2540"
                        Visibility="{Binding IsSystemNotificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SystemNotification}"
                               Foreground="#E9D5FF"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <Button Content="{Binding UpdateNotification}"
                        Command="{Binding OpenUpdateCommand}"
                        Padding="8,6"
                        Margin="0,0,0,8"
                        Background="#3A2D12"
                        Foreground="#FDE68A"
                        FontSize="11"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <views:MascotView/>

                    <Grid Grid.Column="1" Margin="12,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Deltha"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="Bold"
                                       FontSize="18"/>
                            <TextBlock Text=" · Wise Monkey"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,6,0,0">
                            <TextBlock Text="System: "
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding StateLabel}"
                                       Foreground="{StaticResource AccentSoftBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="  •  "
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding CurrentTime}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Margin="0,5,0,0">
                            <ToggleButton Content="DND"
                                          IsChecked="{Binding IsDoNotDisturb}"
                                          ToolTip="Toggle Do Not Disturb"
                                          Margin="0,0,5,0"
                                          Padding="5,1"
                                          FontSize="10"/>
                            <ToggleButton Content="🔇"
                                          IsChecked="{Binding IsAudioMuted}"
                                          ToolTip="Toggle muted audio"
                                          Margin="0,0,5,0"
                                          Padding="5,1"
                                          FontSize="10"/>
                            <ToggleButton Content="🎙"
                                          IsChecked="{Binding IsMicrophoneMuted}"
                                          ToolTip="Toggle muted microphone"
                                          Padding="5,1"
                                          FontSize="10"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="2"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding BatteryPercent, StringFormat={}{0}%}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding BatteryStatus}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   HorizontalAlignment="Right"/>
                        <Border Width="70"
                                Height="10"
                                CornerRadius="5"
                                Background="#1F2937"
                                Margin="0,6,0,0">
                            <Border Width="{Binding BatteryPercent}"
                                    MaxWidth="70"
                                    HorizontalAlignment="Left"
                                    CornerRadius="5"
                                    Background="{StaticResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <views:MediaView x:Name="MediaPanel"
                                 Height="Auto"
                                 Margin="0"/>

                <StackPanel x:Name="DropActionsPanel"
                            DataContext="{Binding DropViewModel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Margin="0,10,0,0">
                    <Border Padding="8,6"
                            CornerRadius="10"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#202334"/>
                                <Setter Property="BorderBrush" Value="#51417D"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDropZoneActive}" Value="True">
                                        <Setter Property="Background" Value="#35275C"/>
                                        <Setter Property="BorderBrush" Value="#A78BFA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding DropZoneMessage}"
                                   Foreground="#C4B5FD"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <WrapPanel HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Visibility="{Binding IsImageReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="Convert to PNG"
                                Command="{Binding ConvertToPngCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="0,0,5,0"
                                Padding="7,4"
                                FontSize="10"/>
                        <Button Content="Convert to JPG"
                                Command="{Binding ConvertToJpgCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="0,0,5,0"
                                Padding="7,4"
                                FontSize="10"/>
                        <Button Content="Convert to PDF"
                                Command="{Binding ConvertToPdfCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="0,0,5,0"
                                Padding="7,4"
                                FontSize="10"/>
                        <Button Content="Extract Text (OCR)"
                                Command="{Binding ExtractTextCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Padding="7,4"
                                FontSize="10"/>
                    </WrapPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#E2E8F0"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Margin="2,5,2,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Border Margin="0,10,0,0"
                        Padding="8"
                        CornerRadius="12"
                        Background="#151E2A">
                    <StackPanel DataContext="{Binding PomodoroViewModel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                        <DockPanel>
                            <TextBlock Text="{Binding PhaseLabel}"
                                       Foreground="#C4B5FD"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TimeDisplay}"
                                       Foreground="#F8FAFC"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0">
                            <Button Content="{Binding StartPauseLabel}"
                                    Command="{Binding StartPauseCommand}"
                                    MinWidth="55"
                                    Margin="0,0,5,0"
                                    Padding="8,3"/>
                            <Button Content="Reset"
                                    Command="{Binding ResetCommand}"
                                    Margin="0,0,5,0"
                                    Padding="8,3"/>
                            <Button Content="Switch Work/Break"
                                    Command="{Binding SwitchPhaseCommand}"
                                    Padding="8,3"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,8,0,0"
                            DataContext="{Binding LauncherViewModel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                    <DockPanel>
                        <Button Content="{Binding Applications.Count, StringFormat=Apps ({0})}"
                                Command="{Binding ToggleExpandedCommand}"
                                Padding="8,3"
                                DockPanel.Dock="Left"/>
                        <Button Content="+"
                                Command="{Binding AddApplicationCommand}"
                                Width="26"
                                Height="25"
                                Margin="6,0,0,0"
                                ToolTip="Add an executable"
                                DockPanel.Dock="Right"/>
                    </DockPanel>

                    <Border Margin="0,6,0,0"
                            Padding="7"
                            CornerRadius="10"
                            Background="#151E2A"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Applications}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Margin="2"
                                                Padding="6,4"
                                                ToolTip="{Binding Path}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}"
                                                       Width="18"
                                                       Height="18"
                                                       Margin="0,0,5,0"/>
                                                <TextBlock Text="▣"
                                                           Foreground="#A78BFA"
                                                           Margin="0,0,5,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name}"
                                                           MaxWidth="95"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       Margin="2,5,2,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
